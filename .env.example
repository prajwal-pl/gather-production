# Provider keys — fill in whichever free tier you have.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Fallback chain. Groq first, OpenRouter's free router second.
# Free model ids rotate: run `python -m gather.check` and keep the ones that pass.
GATHER_MODEL_CHAIN=groq:openai/gpt-oss-120b,openrouter:nvidia/nemotron-3.5-lightning:free,openrouter:inclusionai/ling-3.2-flash:free

# Free tiers are rate limited: pace calls and cap work per run.
GATHER_MIN_INTERVAL=2
GATHER_MAX_CALLS=24
GATHER_CHUNK_CHARS=9000
GATHER_MAX_CHUNKS=12

# Storage
GATHER_DB=.gather/gather.db
GATHER_ORG_NAME=Acme

# Connectors (leave empty to use bundled fixtures)
FIREFLIES_API_KEY=
FIREFLIES_WEBHOOK_SECRET=
GMAIL_ACCESS_TOKEN=
GMAIL_WEBHOOK_TOKEN=

# Slack
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=

# Flip to 1 only after you trust the drafts.
GATHER_AUTO_APPROVE=0
